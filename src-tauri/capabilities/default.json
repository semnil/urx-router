{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core access, native open/save dialogs, auto-update, and every app command for the main window. The app commands are listed rather than implied: with no app ACL manifest Tauri gates none of them, which is what let the MIDI webview reach the device and the filesystem.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    "allow-app-build-kind",
    "allow-append-link-log",
    "allow-close-midi-window",
    "allow-experimental-enabled",
    "allow-focus-midi-window",
    "allow-midi-close-input",
    "allow-midi-close-output",
    "allow-midi-list-inputs",
    "allow-midi-list-outputs",
    "allow-midi-open-input",
    "allow-midi-open-output",
    "allow-midi-open-ports",
    "allow-midi-send",
    "allow-midi-ui-attach-main",
    "allow-midi-ui-attach-window",
    "allow-midi-ui-to-main",
    "allow-midi-ui-to-window",
    "allow-midi-window-open",
    "allow-open-midi-window",
    "allow-pin-midi-window",
    "allow-prepare-modified-requested",
    "allow-read-binary-file",
    "allow-read-text-file",
    "allow-reset-storage-requested",
    "allow-self-test-requested",
    "allow-set-edit-menu-labels",
    "allow-set-edit-menu-state",
    "allow-set-keep-awake",
    "allow-third-party-licenses",
    "allow-vd-connect",
    "allow-vd-disconnect",
    "allow-vd-get",
    "allow-vd-get-str",
    "allow-vd-link-stats",
    "allow-vd-meters-subscribe",
    "allow-vd-meters-unsubscribe",
    "allow-vd-params-subscribe",
    "allow-vd-params-unsubscribe",
    "allow-vd-set",
    "allow-vd-set-str",
    "allow-vd-watch-link",
    "allow-write-binary-file",
    "allow-write-text-file"
  ]
}
